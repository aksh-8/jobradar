# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=./data/jobradar.db
CORS_ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=30
MAX_SCORING_JOBS_PER_RUN=50
AVAILABILITY_CHECK_LIMIT=20
AVAILABILITY_CHECK_INTERVAL_HOURS=12
CONTACT_CACHE_DAYS=7
CONTACT_RESULTS_PER_JOB=3

# Scoring policy
MINIMUM_OVERALL_SCORE=60
MINIMUM_BASE_SALARY_USD=140000
MINIMUM_COMPANY_SIZE=50
FOLLOW_UP_AFTER_DAYS=14

# Gemini primary scoring provider
GEMINI_API_KEY=replace_with_google_ai_api_key
GEMINI_MODEL=gemini-3.6-flash
COVER_LETTER_MODEL=gemini-3.6-flash

# Ollama offline fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Job discovery: free direct ATS monitors plus bounded Brave gap searches.
# JOB_SEARCH_PROVIDER is used only with manual --query runs.
JOB_SEARCH_PROVIDER=brave
JOB_SEARCH_QUERIES="senior software engineer USA|platform engineer USA|developer experience engineer USA|SDET USA|quality automation engineer USA|AI automation engineer USA|forward deployed engineer USA"
RESUME_PROFILE_ID=auto
RESUME_PROFILE_PATH=./config/resume_profile.json
BRAVE_SEARCH_API_KEY=replace_with_brave_search_api_key
ENABLE_SERPAPI_DISCOVERY=false
ENABLE_CUSTOM_CAREER_POLLING=false
PRIORITY_COMPANIES="Apple|Google|Microsoft|Amazon|Meta|NVIDIA|Tesla"
KNOWN_SPONSOR_COMPANIES="Apple|Google|Microsoft|Amazon|Amazon.com Services LLC|Meta|Meta Platforms|NVIDIA|Tesla"
FDE_TARGET_COMPANIES="Glean|Cohere|Scale AI"
GREENHOUSE_BOARDS="scaleai=Scale AI|gleanwork=Glean|affirm=Affirm|anthropic=Anthropic|block=Block|cloudflare=Cloudflare|databricks=Databricks|figma=Figma|flexport=Flexport|lyft=Lyft|pagerduty=PagerDuty|singlestore=SingleStore|verkada=Verkada|zscaler=Zscaler"
LEVER_BOARDS=
ASHBY_BOARDS="cohere=Cohere|linear=Linear"
CUSTOM_CAREER_PAGES="Apple=https://jobs.apple.com/en-us/search|Google=https://www.google.com/about/careers/applications/jobs/results/|Microsoft=https://jobs.careers.microsoft.com/global/en/search|Amazon=https://www.amazon.jobs/en/search|Meta=https://www.metacareers.com/jobs/|NVIDIA=https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite|Tesla=https://www.tesla.com/careers/search/"

# Email delivery: choose gmail or sendgrid
EMAIL_PROVIDER=gmail
DIGEST_RECIPIENT_EMAIL=replace_with_recipient_address
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=replace_with_gmail_address
GMAIL_APP_PASSWORD=replace_with_gmail_app_password
SENDGRID_API_KEY=replace_with_sendgrid_api_key
SENDGRID_FROM_EMAIL=replace_with_verified_sender_address
SEND_EMPTY_DIGEST=false
